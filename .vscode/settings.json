{
  "cSpell.words": [
    "amax",
    "camara",
    "configuracion",
    "deteccion",
    "Deteccion",
    "epoca",
    "epocas",
    "Grrrr",
    "Grrrrr",
    "Implementacion",
    "maximo",
    "politica",
    "semaforo",
    "semaforos",
    "simulacion",
    "sincronizacion",
    "Sincronizacion",
    "Vehiculo",
    "vehiculos",
    "Vehiculos",
    "Xtra",
    "yolov"
  ],
  "[python]": {
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit",
      "source.fixAll.ruff": "explicit"
    },
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "ruff.enable": true,
  "ruff.fixAll": true,
  "ruff.organizeImports": true,
  "ruff.codeAction.fixViolation": {
    "enable": true
  },

  // Configuración adicional del editor
  "editor.rulers": [88],
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // Configuración de Black
  "black-formatter.args": ["--line-length=88"],

  "mypy-type-checker.preferDaemon": true,
  "mypy-type-checker.reportingScope": "workspace",
  "mypy-type-checker.importStrategy": "fromEnvironment",

  // Configuración de GitHub Copilot para el proyecto
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,
  "chat.promptFiles": true,

  // Configuraciones específicas para el proyecto
  "github.copilot.chat.commitMessageGeneration.instructions": [
    { "text": "Utilizar idioma 'Español' para todos los mensajes" },
    { "text": "Usar Conventional Commits: tipo(ámbito): descripción" },
    { "text": "Tipos: feat, fix, docs, refactor, test, chore" },
    {
      "text": "Incluir los detalles relevantes de los cambios en el cuerpo del mensaje, si aplica."
    }
  ],

  "github.copilot.chat.reviewSelection.instructions": [
    { "text": "Verificar que se siguen las convenciones del proyecto" },
    { "text": "Comprobar que se usa config.yaml en lugar de hardcoding" },
    { "text": "Revisar que los imports sean absolutos desde src/" },
    { "text": "Verificar manejo de errores en APIs REST" }
  ],

  // Configuración de archivos de instrucciones
  "chat.instructionsFilesLocations": {
    ".github/instructions": true
  },

  "chat.promptFilesLocations": {
    ".github/prompts": true
  }
}
