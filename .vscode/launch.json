{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Poetry: Debug (File)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/src"
      },
      "stopOnEntry": false,
      "justMyCode": false
    },
    {
      "name": "Poetry: Simulation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_simulation_provider.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/src"
      },
      "stopOnEntry": false,
      "justMyCode": false
    },
    {
      "name": "Poetry: Decisión",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_decision_agent.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/src"
      },
      "stopOnEntry": false,
      "justMyCode": false
    },
    {
      "name": "Poetry: Deteccion",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_detection_provider.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/src"
      },
      "stopOnEntry": false,
      "justMyCode": false
    },
    {
      "name": "Poetry: Reporte",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_reporting_service.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/src"
      },
      "stopOnEntry": false,
      "justMyCode": false
    },
    {
      "name": "Poetry: Frontend (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": [
        "run",
        "${workspaceFolder}/run_frontend.py",
        "--server.port",
        "8501",
        "--server.headless",
        "true"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/src",
        "STREAMLIT_LOGGER_LEVEL": "INFO",
        "STREAMLIT_CLIENT_SHOW_ERROR_DETAILS": "true",
        "STREAMLIT_GLOBAL_DEVELOPMENT_MODE": "false"
      },
      "stopOnEntry": false,
      "justMyCode": false
    },
    {
      "name": "Poetry: Frontend (Direct)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_frontend.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/src",
        "STREAMLIT_LOGGER_LEVEL": "INFO",
        "STREAMLIT_CLIENT_SHOW_ERROR_DETAILS": "true",
        "STREAMLIT_GLOBAL_DEVELOPMENT_MODE": "false"
      },
      "stopOnEntry": false,
      "justMyCode": false
    }
  ]
}
