{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Poetry: Debug (File)",
      "type": "debugpy",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/src"
      },
      "stopOnEntry": false,
      "justMyCode": false
    },
    {
      "name": "Poetry: Simulation",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_simulation_provider.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/src"
      },
      "stopOnEntry": false,
      "justMyCode": false
    },
    {
      "name": "Poetry: Decisión",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_decision_agent.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/src"
      },
      "stopOnEntry": false,
      "justMyCode": false
    },
    {
      "name": "Poetry: Deteccion",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run_detection_provider.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}:${workspaceFolder}/src"
      },
      "stopOnEntry": false,
      "justMyCode": false
    }
  ]
}
